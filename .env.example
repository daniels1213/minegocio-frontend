VITE_CLOUDINARY_UPLOAD_PRESET=minegocio_catalogo_portada

# Each upload preset should point to the matching Cloudinary folder
VITE_CLOUDINARY_PROFILE_CLOUD_NAME=
VITE_CLOUDINARY_PROFILE_UPLOAD_PRESET=minegocio_user_photo
VITE_CLOUDINARY_PRODUCT_CLOUD_NAME=
VITE_CLOUDINARY_PRODUCT_UPLOAD_PRESET=minegocio_product_photo